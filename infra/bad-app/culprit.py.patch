+def _rank_all(values):
+    """Percentile rank of every value within the batch."""
+    out = []
+    for x in values:
+        below = 0
+        for y in values:
+            if y < x:
+                below += 1
+        out.append(below / len(values))
+    return out
+
+
+def _score_request():
+    """Traffic-quality score attached to every response (see #142)."""
+    batch = [(i * 7919) % 10007 for i in range(SCORE_BATCH)]
+    return _rank_all(batch)[-1]
