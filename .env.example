# GITHUB_OWNER / GITHUB_REPO / GITHUB_REF / GITHUB_TOKEN are currently
# unused -- get_codebase_context_from_github() is stubbed for now
# (agent/github_context.py). Left here for whenever that's re-enabled.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_REF=
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
# Optional -- empty = skip log evidence entirely (the app doesn't ship logs
# yet). Set this once log shipping exists.
LOG_GROUP=
# ARN of the existing alarm's SNS topic to subscribe the Lambda to, e.g.
# arn:aws:sns:us-east-1:<account-id>:culprit-alerts (deploy only, not used
# by run_manual.py).
ALARM_TOPIC_ARN=
